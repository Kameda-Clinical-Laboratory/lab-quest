# このファイルをコピーして .env.local を作り、実際の値を入れてください。
# .env.local は .gitignore の "*.local" ルールで既にコミット対象外です。
#
#   cp .env.local.example .env.local
#
# 値の取得場所: Supabaseダッシュボード > Project Settings > API

# --- フロントエンド(ブラウザ)にバンドルされる値。VITE_ プレフィックス必須 ---
# Project URL (例: https://xxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# "anon public" キー、または新形式の "Publishable key"(sb_publishable_...)。
# 公開して問題ない前提のキー(RLSで守る)。
# 注意: Edge FunctionsがwithSupabaseラッパー(auth: ["publishable"])を使っている場合、
# 旧形式のanon(JWT形式)キーではなく、Project Settings > API Keys にある
# 新形式の Publishable key (sb_publishable_...) を使う必要がある。
VITE_SUPABASE_ANON_KEY=

# --- 絶対にフロントエンドにバンドルしてはいけない値。VITE_ を付けないこと ---
# "service_role" key。シードスクリプトやEdge Functionからのみ使用する。
# 誤って VITE_ を付けるとブラウザに漏洩するので厳禁。
SUPABASE_SERVICE_ROLE_KEY=

# --- バックエンド切り替えフラグ(Phase 1で導入) ---
# 'mock'(既定・未設定時) = 従来どおり src/mocks のインメモリデータを使う
# 'supabase'             = カリキュラム(stages/units/beats)をSupabaseから取得する
#                          (学生/進捗/認証はPhase 2・3で切り替えるまでモックのまま)
VITE_BACKEND_MODE=supabase
